<Window x:Class="MultiAudio.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MultiAudio.UI"
        mc:Ignorable="d"
        Title="MultiAudio (MVP)" Height="600" Width="400" Background="#1E1E1E">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Text="MultiAudio" FontSize="24" FontWeight="Bold" Foreground="White" Margin="0,0,0,10"/>

        <!-- Master Section -->
        <Border Grid.Row="1" Background="#2D2D30" CornerRadius="5" Padding="10" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="MASTER" Foreground="#AAAAAA" FontWeight="SemiBold" Margin="0,0,0,10"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Volume" Foreground="White" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <Slider Grid.Column="1" Minimum="0" Maximum="100" Value="78" VerticalAlignment="Center" Foreground="White"/>
                    <TextBlock Grid.Column="2" Text="78%" Foreground="White" VerticalAlignment="Center" Margin="10,0,0,0" Width="30"/>
                </Grid>
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <Button x:Name="StartRoutingButton" Content="Start Routing" Width="100" Margin="0,0,10,0" Click="StartRoutingButton_Click"/>
                    <Button x:Name="StopRoutingButton" Content="Stop Routing" Width="100" Click="StopRoutingButton_Click" IsEnabled="False"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Devices Section -->
        <GroupBox Grid.Row="2" Header="OUTPUT DEVICES" Foreground="#AAAAAA" BorderBrush="#3F3F46">
            <ListBox x:Name="DevicesList" Background="Transparent" BorderThickness="0" Margin="0,10,0,0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#2D2D30" CornerRadius="5" Padding="10" Margin="0,0,0,10" Width="330">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                
                                <CheckBox IsChecked="{Binding IsEnabled}" Content="{Binding Name}" Foreground="White" FontWeight="Bold" Grid.ColumnSpan="2"/>
                                <TextBlock Text="{Binding VolumeText}" Foreground="White" Grid.Column="2" HorizontalAlignment="Right"/>
                                
                                <TextBlock Text="{Binding DelayText}" Foreground="#AAAAAA" Grid.Row="1" Grid.Column="2" HorizontalAlignment="Right" Margin="0,5,0,0"/>
                                
                                <StackPanel Grid.Row="2" Grid.ColumnSpan="3" Orientation="Horizontal" Margin="0,10,0,0" HorizontalAlignment="Right">
                                    <Button Content="Mute" Margin="0,0,5,0" Width="50"/>
                                    <Button Content="Settings" Width="60"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </GroupBox>

        <!-- Footer -->
        <Grid Grid.Row="3" Margin="0,10,0,0">
            <Button Content="+ Add Device" HorizontalAlignment="Left" Padding="10,5"/>
            <ComboBox SelectedIndex="0" Width="120" HorizontalAlignment="Right">
                <ComboBoxItem Content="Default Profile"/>
            </ComboBox>
        </Grid>
    </Grid>
</Window>
